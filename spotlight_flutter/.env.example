# Spotlight Flutter app build settings.
# Flutter doesn't read this file directly: pass the values at build time with --dart-define-from-file:
#   flutter run --dart-define-from-file=.env
#   flutter build appbundle --release --dart-define-from-file=.env
# Without them the app uses the production defaults built into the code.

# Spotlight API, ending in /api (Android emulator to a local API: http://10.0.2.2:5000/api)
API_BASE_URL=https://spotlight.msrit.edu/api

# Google OAuth Web client ID: the same one the backend checks Google sign-in tokens against
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
