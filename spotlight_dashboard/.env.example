# Spotlight web app (club dashboard, /student and /admin).
# Copy to .env (local) or .env.production (build) and fill in. Real .env files are never committed.

# Spotlight API, ending in /api
VITE_API_URL=http://localhost:5000/api

# Google OAuth Web client ID (Google Cloud > APIs & Services > Credentials).
# Must be the same client ID the backend's GOOGLE_CLIENT_ID uses.
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Only when the site is served from a sub-folder, e.g. /spotlight/ (default: /)
# VITE_BASE_PATH=/
