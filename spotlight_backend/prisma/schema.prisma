generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id            String         @id
  fullName      String         @map("full_name")
  email         String         @unique
  password      String?
  usn           String?        @unique
  branch        String?
  phone         String?
  year          Int?
  sem           Int?
  clubId        String?        @map("club_id")
  club          Club?          @relation(fields: [clubId], references: [id])
  registrations Registration[]
}

model Club {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  logoUrl          String?           @map("logo_url")
  password         String?
  qrUrl            String?           @map("qr_url")
  upiId            String?           @map("upi_id")
  events           Event[]
  admins           Profile[]
  registrationKeys RegistrationKey[]
}

model Event {
  id                   String         @id @default(uuid())
  clubId               String         @map("club_id")
  name                 String
  description          String
  eventType            String         @map("event_type")
  fee                  Float          @default(0)
  registrationLimit    Int            @map("registration_limit")
  registrationDeadline DateTime       @map("registration_deadline")
  eventDate            DateTime       @map("event_date")
  qrUrl                String?        @map("qr_url")
  bannerUrl            String?        @map("banner_url")
  venue                String?
  teamSizeLimit        Int?           @map("team_size_limit")
  minTeamSize          Int?           @map("min_team_size")
  eventEndDate         DateTime?      @map("event_end_date")
  upiId                String?        @map("upi_id")
  club                 Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  notifications        Notification[]
  registrations        Registration[]
  teams                Team[]
}

model Team {
  id            String         @id @default(uuid())
  eventId       String         @map("event_id")
  teamName      String         @map("team_name")
  passkey       String         @unique
  leaderId      String         @map("leader_id")
  registrations Registration[]
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Registration {
  id              String             @id @default(uuid())
  eventId         String             @map("event_id")
  userId          String             @map("user_id")
  teamId          String?            @map("team_id")
  paymentProofUrl String?            @map("payment_proof_url")
  status          RegistrationStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  transactionId   String?            @map("transaction_id")
  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team            Team?              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  profile         Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now())
  eventId   String?  @map("event_id")
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model RegistrationKey {
  id           String    @id @default(uuid())
  code         String    @unique
  isUsed       Boolean   @default(false) @map("is_used")
  usedByClubId String?   @map("used_by_club_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  usedAt       DateTime? @map("used_at")
  usedByClub   Club?     @relation(fields: [usedByClubId], references: [id])
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  REJECTED
}
