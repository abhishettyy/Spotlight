generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

model Profile {
  id            String         @id
  fullName      String         @map("full_name")
  email         String         @unique(map: "email")
  password      String?
  usn           String?        @unique(map: "usn")
  branch        String?
  phone         String?
  year          Int?
  sem           Int?
  clubId        String?        @map("club_id")
  club          Club?          @relation(fields: [clubId], references: [id], map: "fk_profile_club")
  registrations Registration[]

  @@index([clubId], map: "fk_profile_club")
}

model Club {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique(map: "email")
  logoUrl          String?           @map("logo_url") @db.Text
  password         String?
  qrUrl            String?           @map("qr_url") @db.Text
  upiId            String?           @map("upi_id")
  description      String?           @db.Text
  department       String?
  coordinatorName  String?           @map("coordinator_name")
  coordinatorPhone String?           @map("coordinator_phone")
  status           ClubStatus        @default(PENDING)
  rejectionReason  String?           @map("rejection_reason") @db.Text
  createdAt        DateTime          @default(now()) @map("created_at")
  reviewedAt       DateTime?         @map("reviewed_at")
  events           Event[]
  admins           Profile[]

  @@index([status], map: "idx_club_status")
}

model Event {
  id                   String         @id @default(uuid())
  clubId               String         @map("club_id")
  name                 String
  description          String         @db.Text
  eventType            String         @map("event_type")
  fee                  Float          @default(0)
  registrationLimit    Int            @map("registration_limit")
  registrationDeadline DateTime       @map("registration_deadline")
  eventDate            DateTime       @map("event_date")
  qrUrl                String?        @map("qr_url") @db.Text
  bannerUrl            String?        @map("banner_url") @db.Text
  venue                String?
  teamSizeLimit        Int?           @map("team_size_limit")
  minTeamSize          Int?           @map("min_team_size")
  eventEndDate         DateTime?      @map("event_end_date")
  upiId                String?        @map("upi_id")
  /// JSON array of branch names allowed to register; null = open to all branches
  allowedBranches      String?        @map("allowed_branches") @db.Text
  club                 Club           @relation(fields: [clubId], references: [id], onDelete: Cascade, map: "fk_event_club")
  notifications        Notification[]
  registrations        Registration[]
  teams                Team[]

  @@index([clubId], map: "fk_event_club")
}

model Team {
  id            String         @id @default(uuid())
  eventId       String         @map("event_id")
  teamName      String         @map("team_name")
  passkey       String?        @unique(map: "passkey")
  leaderId      String         @map("leader_id")
  registrations Registration[]
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade, map: "fk_team_event")

  @@index([eventId], map: "fk_team_event")
}

model Registration {
  id              String             @id @default(uuid())
  eventId         String             @map("event_id")
  userId          String             @map("user_id")
  teamId          String?            @map("team_id")
  paymentProofUrl String?            @map("payment_proof_url") @db.Text
  status          RegistrationStatus @default(PENDING)
  createdAt       DateTime           @default(now()) @map("created_at")
  transactionId   String?            @map("transaction_id")
  checkedInAt     DateTime?          @map("checked_in_at")
  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade, map: "fk_registration_event")
  profile         Profile            @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_registration_profile")
  team            Team?              @relation(fields: [teamId], references: [id], onDelete: Cascade, map: "fk_registration_team")

  @@index([eventId], map: "fk_registration_event")
  @@index([userId], map: "fk_registration_profile")
  @@index([teamId], map: "fk_registration_team")
  @@index([eventId, status], map: "idx_registration_event_status")
  @@index([eventId, userId, status], map: "idx_registration_event_user_status")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  eventId   String?  @map("event_id")
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade, map: "fk_notification_event")

  @@index([eventId], map: "fk_notification_event")
  @@index([userId, createdAt], map: "idx_notification_user_created")
}

/// A club signs up as PENDING and can sign in only once the admin approves it.
enum ClubStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  REJECTED
}
