generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model clubs {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String
  email      String    @unique
  logo_url   String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  events     events[]
}

model events {
  id                    String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  club_id               String?         @db.Uuid
  name                  String
  description           String?
  event_type            String?
  fee                   Int?            @default(0)
  registration_limit    Int?
  registration_deadline DateTime?       @db.Timestamptz(6)
  event_date            DateTime?       @db.Timestamptz(6)
  qr_url                String?
  created_at            DateTime?       @default(now()) @db.Timestamptz(6)
  clubs                 clubs?          @relation(fields: [club_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  registrations         registrations[]
  teams                 teams[]
}

model profiles {
  id            String          @id
  full_name     String?
  usn           String?         @unique
  email         String?         @unique
  password      String?
  branch        String?
  phone         String?
  year          String?
  sem           String?
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  registrations registrations[]
  teams         teams[]
  notifications notifications[]
}

model registrations {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  event_id          String?   @db.Uuid
  user_id           String?
  team_id           String?   @db.Uuid
  payment_proof_url String?
  status            String?   @default("pending")
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  events            events?   @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teams             teams?    @relation(fields: [team_id], references: [id], onUpdate: NoAction)
  profiles          profiles? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model teams {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  event_id      String?         @db.Uuid
  team_name     String
  passkey       String          @unique
  leader_id     String?
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  registrations registrations[]
  events        events?         @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles      profiles?       @relation(fields: [leader_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model notifications {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String
  type       String    // "event_reminder" | "registration_approved" | "registration_pending"
  title      String
  body       String
  is_read    Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  profiles   profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
