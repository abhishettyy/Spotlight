datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id            String         @id // Linked directly to Clerk User ID
  fullName      String         @map("full_name")
  email         String         @unique
  password      String?        // Used for legacy custom JWT fallback
  usn           String?        @unique // Captured during onboarding
  branch        String?
  phone         String?
  year          Int?
  sem           Int?
  clubId        String?        @map("club_id") // If they are a club admin
  club          Club?          @relation(fields: [clubId], references: [id], onDelete: SetNull)
  registrations Registration[]
}

model Club {
  id       String    @id @default(uuid())
  name     String
  email    String    @unique
  password String?   // For direct legacy/custom club login verification
  logoUrl  String?   @map("logo_url")
  upiId    String?   @map("upi_id")
  qrUrl    String?   @map("qr_url")
  events   Event[]
  admins   Profile[]
}

model Event {
  id                  String         @id @default(uuid())
  clubId              String         @map("club_id")
  club                Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name                String
  description         String
  venue               String?        // Field to store the event location/venue
  eventType           String         @map("event_type") // Solo or Team
  teamSizeLimit       Int?           @map("team_size_limit")
  minTeamSize         Int?           @map("min_team_size")
  fee                 Float          @default(0)        // 0 = Free
  registrationLimit   Int            @map("registration_limit")
  registrationDeadline DateTime       @map("registration_deadline")
  eventDate           DateTime       @map("event_date")
  qrUrl               String?        @map("qr_url")
  bannerUrl           String?        @map("banner_url") // Added to store event banners/posters
  registrations       Registration[]
  teams               Team[]
  notifications       Notification[]
}

model Team {
  id            String         @id @default(uuid())
  eventId       String         @map("event_id")
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamName      String         @map("team_name")
  passkey       String         @unique // Unique 5-char alphanumeric code (UX optimized)
  leaderId      String         @map("leader_id")
  registrations Registration[]
}

model Registration {
  id              String             @id @default(uuid())
  eventId         String             @map("event_id")
  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId          String             @map("user_id")
  profile         Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId          String?            @map("team_id")
  team            Team?              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  paymentProofUrl String?            @map("payment_proof_url")
  transactionId   String?            @map("transaction_id")
  status          RegistrationStatus @default(PENDING)
  createdAt       DateTime           @default(now())

  @@unique([eventId, userId]) // Duplicate prevention at the database level
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now())
  eventId   String?  @map("event_id")
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}
