# MySQL / MariaDB connection string
# On cPanel, database and user names are prefixed with the cPanel username (e.g. u12345_spotlight)
DATABASE_URL="mysql://dbuser:password@localhost:3306/spotlight"

PORT=5000

# Signs all user and admin session tokens. Use a long random value.
JWT_SECRET="change_me"

# Google OAuth client used by the apps; the API verifies sign-in tokens against it
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Image uploads (event banners, club logos, payment QR codes) go to upload.php on the file host
GODADDY_UPLOAD_URL="https://yourdomain.com/upload.php"
UPLOAD_SECRET="change_me"

# Optional fallback image storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
