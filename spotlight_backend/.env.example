# MySQL / MariaDB connection string
# On cPanel, database and user names are prefixed with the cPanel username (e.g. u12345_spotlight)
DATABASE_URL="mysql://dbuser:password@localhost:3306/spotlight"

PORT=5000

# Signs all user and admin session tokens. Required; use a long random value.
JWT_SECRET="change_me"

# Password for the built-in admin account, used only when that account is first created.
# If unset, a random one is generated and printed to the server log once.
ADMIN_INITIAL_PASSWORD=""

# Shared secret a scheduled job sends as the X-Cron-Secret header to POST /api/notifications/event-reminders.
# Leave empty to keep that endpoint off.
CRON_SECRET=""

# Time zone event times are entered in. Deadlines and "event finished" checks use it.
CAMPUS_TIME_ZONE="Asia/Kolkata"

# Google OAuth client used by the apps; the API verifies sign-in tokens against it
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Public address of this API, ending in /api (the same value the website uses as VITE_API_URL)
PUBLIC_API_URL="https://api.example.com/api"

# ── Image uploads (event banners, club logos): choose ONE option ──
# Option A (default): saved on this server's disk and served at <PUBLIC_API_URL>/uploads/...
#   The folder must be on persistent storage and included in backups.
UPLOAD_DIR="./uploads"
# Option B: S3-compatible object storage (AWS S3, Cloudflare R2, Google Cloud Storage, MinIO…).
#   Used whenever S3_BUCKET is set. S3_PUBLIC_URL is the public base URL the images are read from
#   (bucket URL or CDN). S3_ENDPOINT only for non-AWS providers; S3_FORCE_PATH_STYLE=true for MinIO.
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE=""
# Legacy: an external upload.php (leave both empty)
GODADDY_UPLOAD_URL=""
UPLOAD_SECRET=""


# The admin console sign-in email (password or Google). Stored on the admin profile.
ADMIN_EMAIL="spotlightapp.help@gmail.com"

# Outgoing mail: tells a club when its registration is approved. Leave all empty to skip the email.
# Option 1 (recommended, works on Render's free plan): Gmail relay, a Google Apps Script web app in the
# admin Gmail account. Setup steps are in mail-relay/README.md. Used first when both are set.
MAIL_RELAY_URL=""
MAIL_RELAY_SECRET=""
# Option 2: Brevo HTTPS API. Verify MAIL_FROM_EMAIL in Brevo > Senders.
BREVO_API_KEY=""
MAIL_FROM_EMAIL="spotlightapp.help@gmail.com"
MAIL_FROM_NAME="Spotlight"
# Option 3: SMTP (blocked on some hosts).
# For Gmail use smtp.gmail.com / 465 and an App Password (Google Account > Security > App passwords),
# not the account's normal password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="spotlightapp.help@gmail.com"
SMTP_PASS=""
MAIL_FROM="Spotlight <spotlightapp.help@gmail.com>"
# Club sign-in page linked from the approval email
CLUB_LOGIN_URL="https://spotlight.msrit.in/?view=auth&authTab=login"
# Admin console linked from the "new club waiting for approval" email
ADMIN_CONSOLE_URL="https://spotlight.msrit.in/admin"
# Optional fallback for who gets the new-club alert, comma-separated. Normally the admin sets
# the list in the admin console (Alerts), which is stored in the database and takes priority.
ADMIN_ALERT_EMAILS=""
